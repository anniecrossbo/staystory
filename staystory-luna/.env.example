# Copy to .env.local (git-ignored). Everything is optional: without keys the apps use cached and rule-based reading,
# an empty live-hotel list, and a placeholder instead of the map.

# Reel caption reading. Claude is used if both are set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Live hotels and rates (LiteAPI)
LITEAPI_KEY=

# Trip maps (Google Static Maps). Kept on the server; the apps call /api/map.
GOOGLE_MAPS_KEY=
